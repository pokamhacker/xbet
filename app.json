{
  "expo": {
    "name": "Bookmaker Studio",
    "slug": "bookmaker-studio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bookmaker.studio",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bookmaker.studio",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#243DB5"
      },
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "1xBet",
      "shortName": "1xBet",
      "themeColor": "#1A568C",
      "backgroundColor": "#EEF2F6",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#243DB5"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "owner": "tchassi",
    "extra": {
      "eas": {
        "projectId": "03244d2a-98dd-4f12-84ff-89820949daf9"
      }
    }
  }
}
